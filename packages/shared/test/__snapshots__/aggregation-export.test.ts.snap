"<?php

require 'vendor/autoload.php';

$client = new MongoDB\\Client(getenv('MONGODB_URI'));
$coll = $client->selectCollection("shop", "orders");
$pipeline = [
  [
    "\\$match" => [
      "_id" => new MongoDB\\BSON\\ObjectId("65a1b2c3d4e5f60718293a4b"),
      "at" => new MongoDB\\BSON\\UTCDateTime(1790503200123),
      "i" => 7,
      "plain" => 42,
      "big" => new MongoDB\\BSON\\Int64("9007199254740993"),
      "d" => 1.0,
      "half" => 1.5,
      "dec" => new MongoDB\\BSON\\Decimal128("12.3400"),
      "re" => new MongoDB\\BSON\\Regex("^a.c\\$", "im"),
      "bin" => new MongoDB\\BSON\\Binary(base64_decode("AQL/"), 0),
      "id" => new MongoDB\\BSON\\Binary(hex2bin("0b1c2d3e4f5046178899aabbccddeeff"), MongoDB\\BSON\\Binary::TYPE_UUID),
      "ts" => new MongoDB\\BSON\\Timestamp(3, 100),
      "lo" => new MongoDB\\BSON\\MinKey(),
      "hi" => new MongoDB\\BSON\\MaxKey(),
      "none" => null,
      "yes" => true,
      "list" => [1, "two", ["three" => 3]],
      "a.b" => 1,
      "with space" => 1,
    ],
  ],
  ["\\$limit" => 5],
];
foreach ($coll->aggregate($pipeline) as $doc) {
    var_dump($doc);
}
"
`;

exports[`exportPipeline (phase 2a spec §4.6) > python: shows every BSON type as that driver writes it 1`] = `
"import base64
import datetime
import os
import uuid

from bson import Binary, Decimal128, Int64, MaxKey, MinKey, ObjectId, Regex, Timestamp
from pymongo import MongoClient

client = MongoClient(os.environ["MONGODB_URI"])
coll = client["shop"]["orders"]
pipeline = [
  {
    "$match": {
      "_id": ObjectId("65a1b2c3d4e5f60718293a4b"),
      "at": datetime.datetime(2026, 9, 27, 10, 0, 0, 123000, tzinfo=datetime.timezone.utc),
      "i": 7,
      "plain": 42,
      "big": Int64(9007199254740993),
      "d": 1.0,
      "half": 1.5,
      "dec": Decimal128("12.3400"),
      "re": Regex("^a.c$", "im"),
      "bin": Binary(base64.b64decode("AQL/"), 0),
      "id": Binary.from_uuid(uuid.UUID("0b1c2d3e-4f50-4617-8899-aabbccddeeff")),
      "ts": Timestamp(100, 3),
      "lo": MinKey(),
      "hi": MaxKey(),
      "none": None,
      "yes": True,
      "list": [1, "two", {"three": 3}],
      "a.b": 1,
      "with space": 1,
    },
  },
  {"$limit": 5},
]
for doc in coll.aggregate(pipeline):
    print(doc)
"
`;

exports[`exportPipeline (phase 2a spec §4.6) > ruby: shows every BSON type as that driver writes it 1`] = `
"require 'base64'
require 'mongo'

client = Mongo::Client.new(ENV.fetch('MONGODB_URI'))
coll = client.use("shop")["orders"]
pipeline = [
  {
    "$match" => {
      "_id" => BSON::ObjectId.from_string("65a1b2c3d4e5f60718293a4b"),
      "at" => Time.at(0, 1790503200123, :millisecond).utc,
      "i" => 7,
      "plain" => 42,
      "big" => BSON::Int64.new(9007199254740993),
      "d" => 1.0,
      "half" => 1.5,
      "dec" => BSON::Decimal128.new("12.3400"),
      "re" => BSON::Regexp::Raw.new("^a.c$", "im"),
      "bin" => BSON::Binary.new(Base64.decode64("AQL/"), :generic),
      "id" => BSON::Binary.from_uuid("0b1c2d3e-4f50-4617-8899-aabbccddeeff"),
      "ts" => BSON::Timestamp.new(100, 3),
      "lo" => BSON::MinKey.new,
      "hi" => BSON::MaxKey.new,
      "none" => nil,
      "yes" => true,
      "list" => [1, "two", { "three" => 3 }],
      "a.b" => 1,
      "with space" => 1,
    },
  },
  { "$limit" => 5 },
]
coll.aggregate(pipeline).each do |doc|
  puts doc
end
"
`;

exports[`exportPipeline (phase 2a spec §4.6) > rust: shows every BSON type as that driver writes it 1`] = `
"use futures::stream::TryStreamExt;
use mongodb::bson::{
    doc, oid::ObjectId, spec::BinarySubtype, Binary, Bson, DateTime, Decimal128, Document, Regex, Timestamp, Uuid,
};
use mongodb::Client;

#[tokio::main]
async fn main() -> mongodb::error::Result<()> {
    let uri = std::env::var("MONGODB_URI").expect("set MONGODB_URI");
    let client = Client::with_uri_str(uri).await?;
    let coll = client.database("shop").collection::<Document>("orders");
    let pipeline = vec![
      doc! {
        "$match": {
          "_id": (ObjectId::parse_str("65a1b2c3d4e5f60718293a4b").unwrap()),
          "at": (DateTime::from_millis(1790503200123)),
          "i": 7_i32,
          "plain": 42_i32,
          "big": 9007199254740993_i64,
          "d": 1.0_f64,
          "half": 1.5_f64,
          "dec": ("12.3400".parse::<Decimal128>().unwrap()),
          "re": (Regex { pattern: "^a.c$".to_string(), options: "im".to_string() }),
          "bin": (Binary { subtype: BinarySubtype::from(0), bytes: vec![1, 2, 255] }),
          "id": (Uuid::parse_str("0b1c2d3e-4f50-4617-8899-aabbccddeeff").unwrap()),
          "ts": (Timestamp { time: 100, increment: 3 }),
          "lo": (Bson::MinKey),
          "hi": (Bson::MaxKey),
          "none": null,
          "yes": true,
          "list": [1_i32, "two", { "three": 3_i32 }],
          "a.b": 1_i32,
          "with space": 1_i32,
        },
      },
      doc! { "$limit": 5_i32 },
    ];
    let mut cursor = coll.aggregate(pipeline).await?;
    while let Some(doc) = cursor.try_next().await? {
        println!("{doc}");
    }
    Ok(())
}
"
`;
